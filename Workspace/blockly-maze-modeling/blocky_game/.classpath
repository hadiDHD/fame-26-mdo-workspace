<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-17">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="org.eclipse.pde.core.requiredPlugins"/>
	<classpathentry including="**/*.java" kind="src" output="target/classes" path="src">
		<attributes>
			<attribute name="optional" value="true"/>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry combineaccessrules="false" kind="src" path="/blocky_model"/>
	<classpathentry combineaccessrules="false" kind="src" path="/blocky_momot"/>
	<classpathentry kind="lib" path="/opt/javafx-sdk/lib/javafx.base.jar"/>
	<classpathentry kind="lib" path="/opt/javafx-sdk/lib/javafx.controls.jar"/>
	<classpathentry kind="lib" path="/opt/javafx-sdk/lib/javafx.fxml.jar"/>
	<classpathentry kind="lib" path="/opt/javafx-sdk/lib/javafx.graphics.jar"/>
	<classpathentry kind="lib" path="/opt/javafx-sdk/lib/javafx.media.jar"/>
	<classpathentry kind="lib" path="/opt/javafx-sdk/lib/javafx.swing.jar"/>
	<classpathentry kind="lib" path="/opt/javafx-sdk/lib/javafx.web.jar"/>
	<classpathentry kind="output" path="target/classes"/>
</classpath>
